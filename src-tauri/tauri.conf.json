{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParKur",
  "version": "0.2.0",
  "identifier": "com.ayazc.nextosinstaller",
  "build": {
    "beforeDevCommand": "npx serve src -l 1420 --no-clipboard",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ParKur — Pardus Kurulum Aracı",
        "width": 950,
        "height": 680,
        "resizable": true,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
