#!/bin/bash
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive

CONF=/var/lib/nextos/nextos.conf
COMPLETE=/var/lib/nextos/firstboot-complete
LOG=/var/log/nextos-firstboot.log

mkdir -p /var/log
exec > >(tee -a "$LOG") 2>&1

# With set -e a single failing command silently kills provisioning and the
# system stays in its live-image state (passwordless live user, installer
# icons, ...). Make any abort loud and traceable instead.
trap 'echo "[nextos-firstboot] FATAL: aborted at line $LINENO (last command: $BASH_COMMAND)" >&2' ERR

if [ -f "$COMPLETE" ]; then
    exit 0
fi

if [ ! -f "$CONF" ]; then
    echo "nextos-firstboot: provisioning config missing"
    exit 1
fi

# Never `. "$CONF"` — SHA-512 crypt hashes contain `$` bytes that must not be
# re-expanded by the shell. Parse KEY='value' lines literally instead.
read_conf_value() {
    local key="$1" line val
    line=$(grep -m1 "^${key}=" "$CONF" 2>/dev/null) || return 1
    val="${line#*=}"
    case "$val" in
        \'*\') val="${val#\'}"; val="${val%\'}" ;;
    esac
    printf '%s' "$val"
}

NEXTOS_USERNAME=$(read_conf_value NEXTOS_USERNAME 2>/dev/null || echo nextos)
NEXTOS_PASSWORD_HASH=$(read_conf_value NEXTOS_PASSWORD_HASH 2>/dev/null || true)
NEXTOS_PASSWORD=$(read_conf_value NEXTOS_PASSWORD 2>/dev/null || true)
NEXTOS_HOSTNAME=$(read_conf_value NEXTOS_HOSTNAME 2>/dev/null || echo nextos)
NEXTOS_LOCALE=$(read_conf_value NEXTOS_LOCALE 2>/dev/null || echo en_US.UTF-8)
NEXTOS_TIMEZONE=$(read_conf_value NEXTOS_TIMEZONE 2>/dev/null || echo UTC)
NEXTOS_ROOT_DISK_PATH=$(read_conf_value NEXTOS_ROOT_DISK_PATH 2>/dev/null || echo /NextOS/root.disk)
NEXTOS_HOST_SERIAL=$(read_conf_value NEXTOS_HOST_SERIAL 2>/dev/null || true)

PASS_FILE=/var/lib/nextos/install.pass
INSTALL_PASS=""
if [ -f "$PASS_FILE" ]; then
    INSTALL_PASS=$(cat "$PASS_FILE")
fi

# Keyboard layout derived from the locale (needed before login greeter too).
case "$NEXTOS_LOCALE" in
    tr_*) KB_LAYOUT="tr" ;;
    de_*) KB_LAYOUT="de" ;;
    fr_*) KB_LAYOUT="fr" ;;
    es_*) KB_LAYOUT="es" ;;
    ru_*) KB_LAYOUT="ru" ;;
    ja_*) KB_LAYOUT="jp" ;;
    zh_*) KB_LAYOUT="cn" ;;
    en_GB*) KB_LAYOUT="gb" ;;
    *)    KB_LAYOUT="us" ;;
esac

# Strip live-installer shortcuts from /etc/skel BEFORE creating the user,
# otherwise useradd -m copies them straight onto the new user's Desktop
# (this is where the "Install Pardus" icon came from).
for _skeldir in /etc/skel/Desktop /etc/skel/.config/autostart; do
    [ -d "$_skeldir" ] || continue
    find "$_skeldir" -maxdepth 1 -iname '*calamares*' -delete 2>/dev/null || true
    find "$_skeldir" -maxdepth 1 -iname '*install*'   -delete 2>/dev/null || true
done

echo "[nextos-firstboot] creating user $NEXTOS_USERNAME"
userdel -r -f "$NEXTOS_USERNAME" 2>/dev/null || true
useradd -m -s /bin/bash -c "$NEXTOS_USERNAME" "$NEXTOS_USERNAME"

shadow_password_ok() {
    local user="$1"
    local field
    field="$(getent shadow "$user" 2>/dev/null | cut -d: -f2)"
    [ -n "$field" ] && [ "$field" != '!' ] && [ "$field" != '*' ]
}

apply_password_hash() {
    local user="$1" hash="$2"
    if [ -z "$hash" ]; then
        return 1
    fi
    if printf '%s:%s\n' "$user" "$hash" | chpasswd -e 2>/tmp/nextos-chpasswd.err; then
        :
    else
        echo "[nextos-firstboot] chpasswd -e failed, trying usermod -p" >&2
        cat /tmp/nextos-chpasswd.err >&2 2>/dev/null || true
        usermod -p "$hash" "$user" 2>/tmp/nextos-usermod.err || {
            cat /tmp/nextos-usermod.err >&2 2>/dev/null || true
            return 1
        }
    fi
    shadow_password_ok "$user"
}

PASSWORD_OK=0
if [ -n "$INSTALL_PASS" ]; then
    echo "[nextos-firstboot] applying install password from initrd"
    if printf '%s:%s\n' "$NEXTOS_USERNAME" "$INSTALL_PASS" | chpasswd; then
        shadow_password_ok "$NEXTOS_USERNAME" && PASSWORD_OK=1
    fi
fi
if [ "$PASSWORD_OK" -ne 1 ] && [ -n "$NEXTOS_PASSWORD_HASH" ]; then
    echo "[nextos-firstboot] applying password hash from config"
    apply_password_hash "$NEXTOS_USERNAME" "$NEXTOS_PASSWORD_HASH" && PASSWORD_OK=1
fi
if [ "$PASSWORD_OK" -ne 1 ] && [ -n "$NEXTOS_PASSWORD" ]; then
    echo "[nextos-firstboot] applying legacy plaintext password from config"
    printf '%s:%s\n' "$NEXTOS_USERNAME" "$NEXTOS_PASSWORD" | chpasswd
    shadow_password_ok "$NEXTOS_USERNAME" && PASSWORD_OK=1
fi
if [ "$PASSWORD_OK" -ne 1 ]; then
    echo "[nextos-firstboot] FATAL: could not set password for $NEXTOS_USERNAME" >&2
    echo "[nextos-firstboot] check $LOG and /tmp/nextos-chpasswd.err" >&2
    exit 1
fi
echo "[nextos-firstboot] password set for $NEXTOS_USERNAME"
shred -u "$PASS_FILE" 2>/dev/null || rm -f "$PASS_FILE"

remove_live_image_accounts() {
    echo "[nextos-firstboot] removing live-image accounts"
    LIVE_USER_NAMES="user live casper pardus debian ubuntu"
    for u in $LIVE_USER_NAMES; do
        if [ "$u" != "$NEXTOS_USERNAME" ] && id "$u" >/dev/null 2>&1; then
            echo "[nextos-firstboot] removing live user $u"
            pkill -KILL -u "$u" 2>/dev/null || true
            userdel -r -f "$u" 2>/dev/null || true
        fi
    done
    LEFTOVER_USERS=$(awk -F: -v keep="$NEXTOS_USERNAME" \
        '$3 >= 1000 && $1 != keep && $1 != "nobody" { print $1 }' /etc/passwd)
    for _name in $LEFTOVER_USERS; do
        echo "[nextos-firstboot] removing leftover account $_name"
        pkill -KILL -u "$_name" 2>/dev/null || true
        userdel -r -f "$_name" 2>/dev/null || true
    done
}
remove_live_image_accounts

sanitize_host_overlay_cpio() {
    local boot_dir="/host/NextOS/boot"
    local overlay="$boot_dir/overlay.cpio.gz"
    local init_src="/usr/local/sbin/nextos-init"
    [ -f "$overlay" ] || return 0
    [ -f "$init_src" ] || { echo "[nextos-firstboot] WARNING: $init_src missing — overlay not rebuilt" >&2; return 0; }
    command -v cpio >/dev/null 2>&1 && command -v gzip >/dev/null 2>&1 || {
        echo "[nextos-firstboot] WARNING: cpio/gzip missing — overlay may still contain install.pass" >&2
        return 0
    }
    local tmp cpio_raw
    tmp=$(mktemp -d)
    cpio_raw=$(mktemp)
    mkdir -p "$tmp/usr/local/sbin"
    cp "$init_src" "$tmp/init"
    chmod 0755 "$tmp/init"
    cp /usr/local/sbin/nextos-firstboot "$tmp/usr/local/sbin/nextos-firstboot"
    chmod 0755 "$tmp/usr/local/sbin/nextos-firstboot"
    (
        cd "$tmp" || exit 1
        find . | cpio -o -H newc 2>/dev/null
    ) > "$cpio_raw" || {
        rm -rf "$tmp" "$cpio_raw"
        echo "[nextos-firstboot] WARNING: overlay cpio rebuild failed" >&2
        return 0
    }
    gzip -9 -c "$cpio_raw" > "$overlay.new" && mv "$overlay.new" "$overlay"
    rm -rf "$tmp" "$cpio_raw"
    sync
    echo "[nextos-firstboot] rebuilt host overlay without install.pass"
}
sanitize_host_overlay_cpio

usermod -aG sudo "$NEXTOS_USERNAME" 2>/dev/null || true
usermod -aG adm,audio,video,plugdev,netdev,bluetooth "$NEXTOS_USERNAME" 2>/dev/null || true

# Disallow empty-password logins: the live image's PAM config may carry
# "nullok", which would let leftover passwordless accounts straight in.
for _pamf in /etc/pam.d/common-auth; do
    [ -f "$_pamf" ] || continue
    sed -i -E 's/[[:space:]]nullok(_secure)?\b//g' "$_pamf" || true
done

echo "[nextos-firstboot] hostname $NEXTOS_HOSTNAME"
echo "$NEXTOS_HOSTNAME" > /etc/hostname
hostnamectl set-hostname "$NEXTOS_HOSTNAME" 2>/dev/null || true
sed -i '/^127\.0\.1\.1/d' /etc/hosts
echo "127.0.1.1  $NEXTOS_HOSTNAME" >> /etc/hosts

echo "[nextos-firstboot] timezone $NEXTOS_TIMEZONE"
if [ -f "/usr/share/zoneinfo/$NEXTOS_TIMEZONE" ]; then
    ln -sf "/usr/share/zoneinfo/$NEXTOS_TIMEZONE" /etc/localtime
    echo "$NEXTOS_TIMEZONE" > /etc/timezone
fi

echo "[nextos-firstboot] locale $NEXTOS_LOCALE"
if [ -f /etc/locale.gen ]; then
    sed -i "s/^# *\(${NEXTOS_LOCALE//./\\.}\)/\1/" /etc/locale.gen || true
    locale-gen "$NEXTOS_LOCALE" 2>/dev/null || true
    update-locale LANG="$NEXTOS_LOCALE" 2>/dev/null || true
fi

echo "[nextos-firstboot] keyboard layout $KB_LAYOUT"
cat > /etc/default/keyboard <<KBD
XKBMODEL="pc105"
XKBLAYOUT="$KB_LAYOUT"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
KBD
dpkg-reconfigure -f noninteractive keyboard-configuration 2>/dev/null || true
setupcon --save 2>/dev/null || true
localectl set-x11-keymap "$KB_LAYOUT" 2>/dev/null || true

# Performance: the purges below fire the update-initramfs trigger once per
# apt/dpkg run. Disable automatic regeneration for the whole provisioning
# phase and generate the initramfs exactly once at the end.
if [ -f /etc/initramfs-tools/update-initramfs.conf ]; then
    sed -i 's/^update_initramfs=.*/update_initramfs=no/' /etc/initramfs-tools/update-initramfs.conf || true
fi
# man-db index rebuilds add minutes to package removal — skip them.
echo 'man-db man-db/auto-update boolean false' | debconf-set-selections 2>/dev/null || true

echo "[nextos-firstboot] purging live + installer packages"
LIVE_PKGS="live-boot live-boot-doc live-boot-initramfs-tools live-config live-config-systemd live-config-doc live-tools casper user-setup"
# The OS installer (Calamares) ships on the live image and puts the
# "Install Pardus" shortcut on the desktop — this system is already
# installed by NextOS, so the installer must go.
INSTALLER_PKGS="calamares calamares-settings-debian calamares-settings-pardus pardus-installer live-installer"
apt-get -y --no-download purge $LIVE_PKGS $INSTALLER_PKGS 2>/dev/null || true
for pkg in $LIVE_PKGS $INSTALLER_PKGS; do
    if dpkg -l "$pkg" 2>/dev/null | grep -q '^ii'; then
        dpkg --purge --force-all "$pkg" 2>/dev/null || true
    fi
done
apt-get -y --no-download autoremove --purge 2>/dev/null || true

# Remove any leftover installer shortcuts from every user's desktop and
# autostart (covers shortcuts already copied from /etc/skel by useradd).
for _desk in /root /home/*; do
    [ -d "$_desk" ] || continue
    for _sub in Desktop Masaüstü .config/autostart; do
        [ -d "$_desk/$_sub" ] || continue
        find "$_desk/$_sub" -maxdepth 1 -iname '*calamares*' -delete 2>/dev/null || true
        find "$_desk/$_sub" -maxdepth 1 -iname '*install*'   -delete 2>/dev/null || true
    done
done
rm -f /usr/share/applications/calamares.desktop \
      /usr/share/applications/*install-debian*.desktop \
      /usr/share/applications/*pardus-installer*.desktop 2>/dev/null || true

systemctl mask live-config.service 2>/dev/null || true
systemctl mask live-config-systemd.service 2>/dev/null || true
systemctl mask live-tools.service 2>/dev/null || true

rm -f /etc/sudoers.d/live /etc/sudoers.d/live-config /etc/sudoers.d/user /etc/sudoers.d/90-live

# Lock the root account's password (sudo via our user is the intended path).
passwd -l root 2>/dev/null || true

echo "[nextos-firstboot] installing persistent initramfs hooks"
install -d -m 0755 /etc/initramfs-tools/hooks

# This hook replaces the stock /init with the NextOS loop-mount init and
# includes all required storage + filesystem modules on every initramfs rebuild.
cat > /etc/initramfs-tools/hooks/nextos-init <<'INITHOOK'
#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac
. /usr/share/initramfs-tools/hook-functions
# Replace stock /init with NextOS custom init
if [ -f /usr/local/sbin/nextos-init ]; then
    install -m 0755 /usr/local/sbin/nextos-init "${DESTDIR}/init"
fi
# Storage drivers (ensures disks appear in /proc/partitions)
manual_add_modules sd_mod sr_mod ahci libahci ata_piix nvme \
    virtio_blk virtio_scsi scsi_mod \
    loop ext4 ntfs ntfs3 squashfs fuse
# Required executables
copy_exec /sbin/losetup   /sbin
copy_exec /sbin/blkid     /sbin
copy_exec /sbin/mkfs.ext4 /sbin
if command -v ntfs-3g >/dev/null 2>&1; then
    copy_exec "$(command -v ntfs-3g)" /sbin
fi
INITHOOK
chmod 0755 /etc/initramfs-tools/hooks/nextos-init

cat > /etc/initramfs-tools/modules <<'MODULES'
loop
ext4
ntfs3
squashfs
sd_mod
ahci
ata_piix
MODULES

echo "[nextos-firstboot] installing kernel/initramfs ESP sync hooks"
install -d -m 0755 /etc/kernel/postinst.d
cat > /etc/kernel/postinst.d/zz-nextos-sync-boot <<'POSTINST'
#!/bin/sh
set -e
VERSION="$1"
BOOT_DIR="/host/NextOS/boot"
mkdir -p /host
mountpoint -q /host 2>/dev/null || mount /host 2>/dev/null || true
[ -d "$BOOT_DIR" ] || { echo "nextos-sync: $BOOT_DIR missing" >&2; exit 0; }
if [ -f "/boot/vmlinuz-$VERSION" ]; then
    install -m 0644 "/boot/vmlinuz-$VERSION" "$BOOT_DIR/vmlinuz.new"
    mv "$BOOT_DIR/vmlinuz.new" "$BOOT_DIR/vmlinuz"
fi
if [ -f "/boot/initrd.img-$VERSION" ]; then
    install -m 0644 "/boot/initrd.img-$VERSION" "$BOOT_DIR/initrd.img.new"
    mv "$BOOT_DIR/initrd.img.new" "$BOOT_DIR/initrd.img"
fi
sync
POSTINST
chmod 0755 /etc/kernel/postinst.d/zz-nextos-sync-boot

install -d -m 0755 /etc/initramfs/post-update.d
cat > /etc/initramfs/post-update.d/zz-nextos-sync-boot <<'POSTIRFS'
#!/bin/sh
set -e
VERSION="$1"
GENERATED="$2"
BOOT_DIR="/host/NextOS/boot"
mkdir -p /host
mountpoint -q /host 2>/dev/null || mount /host 2>/dev/null || true
[ -d "$BOOT_DIR" ] || { echo "nextos-sync: $BOOT_DIR missing" >&2; exit 0; }
[ -n "$GENERATED" ] || exit 0
[ -f "$GENERATED" ] || exit 0
install -m 0644 "$GENERATED" "$BOOT_DIR/initrd.img.new"
mv "$BOOT_DIR/initrd.img.new" "$BOOT_DIR/initrd.img"
sync
POSTIRFS
chmod 0755 /etc/initramfs/post-update.d/zz-nextos-sync-boot

echo "[nextos-firstboot] persisting host fstab entry"
mkdir -p /host
ROOT_DEV=$(findmnt -no SOURCE /)
HOST_DEV=$(findmnt -no SOURCE /host 2>/dev/null || true)
# Use the real blkid UUID of the host device (NTFS 64-bit serial). The Windows
# 32-bit serial in NEXTOS_HOST_SERIAL does NOT match the by-uuid symlink.
HOST_FSTAB_SRC=""
if [ -n "$HOST_DEV" ]; then
    HOST_UUID=$(blkid -s UUID -o value "$HOST_DEV" 2>/dev/null || true)
    if [ -n "$HOST_UUID" ]; then
        HOST_FSTAB_SRC="UUID=$HOST_UUID"
    else
        HOST_FSTAB_SRC="$HOST_DEV"
    fi
fi
cat > /etc/fstab <<FSTAB
$ROOT_DEV  /        ext4    defaults,noatime,errors=remount-ro,commit=60   0 1
FSTAB
if [ -n "$HOST_FSTAB_SRC" ]; then
    echo "$HOST_FSTAB_SRC  /host  ntfs3  defaults,noatime,nofail  0 0" >> /etc/fstab
fi

ensure_host_mounted() {
    mkdir -p /host
    if mountpoint -q /host 2>/dev/null; then
        return 0
    fi
    mount /host 2>/dev/null && return 0
    mount -t ntfs3 -o rw,noatime /host 2>/dev/null && return 0
    mount -t ntfs-3g -o rw,noatime /host 2>/dev/null && return 0
    echo "[nextos-firstboot] WARNING: /host mount failed — NTFS boot sync may not work" >&2
    return 1
}
ensure_host_mounted || true

# Scrub every autologin rule the live image ships
# autologin for the new user; the display manager must prompt for a password
# on every boot.
echo "[nextos-firstboot] scrubbing live-image autologin configuration"
if [ -f /etc/lightdm/lightdm.conf ]; then
    sed -i -E 's/^[[:space:]]*(autologin-user|autologin-user-timeout|autologin-guest)[[:space:]]*=.*//g' /etc/lightdm/lightdm.conf || true
fi
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-nextos-keyboard.conf <<KBDCONF
[Seat:*]
greeter-setup-script=/bin/sh -c 'setxkbmap ${KB_LAYOUT} 2>/dev/null || true'
KBDCONF
if [ -f /etc/lightdm/lightdm-gtk-greeter.conf ]; then
    sed -i '/^#\?keyboard=/d' /etc/lightdm/lightdm-gtk-greeter.conf || true
    echo "keyboard=${KB_LAYOUT}" >> /etc/lightdm/lightdm-gtk-greeter.conf
fi
if [ -d /etc/lightdm/lightdm.conf.d ]; then
    { grep -l 'autologin' /etc/lightdm/lightdm.conf.d/*.conf 2>/dev/null || true; } | while read -r _f; do
        rm -f "$_f"
    done
fi
if [ -f /etc/gdm3/daemon.conf ]; then
    sed -i -E 's/^[[:space:]]*(AutomaticLogin|AutomaticLoginEnable|TimedLogin|TimedLoginEnable)[[:space:]]*=.*//g' /etc/gdm3/daemon.conf || true
fi
if [ -d /etc/sddm.conf.d ]; then
    { grep -l -i 'autologin' /etc/sddm.conf.d/*.conf 2>/dev/null || true; } | while read -r _f; do
        rm -f "$_f"
    done
fi

DM_SET=""
for dm in lightdm gdm3 sddm; do
    if [ -f "/lib/systemd/system/$dm.service" ] || [ -f "/etc/systemd/system/$dm.service" ]; then
        if systemctl enable "$dm.service" 2>/dev/null; then
            DM_SET="$dm"
            break
        fi
    fi
done
systemctl set-default graphical.target 2>/dev/null || true
echo "[nextos-firstboot] display manager $DM_SET enabled (password required at login)"

# Re-enable automatic initramfs updates for the system's future life,
# then generate it exactly once for the running kernel only.
if [ -f /etc/initramfs-tools/update-initramfs.conf ]; then
    sed -i 's/^update_initramfs=.*/update_initramfs=yes/' /etc/initramfs-tools/update-initramfs.conf || true
fi
echo "[nextos-firstboot] regenerating initramfs (single pass, current kernel)"
update-initramfs -u -k "$(uname -r)" || update-initramfs -u -k all || true

CUR_KERNEL=$(uname -r)
BOOT_DIR="/host/NextOS/boot"
if ensure_host_mounted && [ -d "$BOOT_DIR" ]; then
    [ -f "/boot/vmlinuz-$CUR_KERNEL" ] && cp "/boot/vmlinuz-$CUR_KERNEL" "$BOOT_DIR/vmlinuz"
    [ -f "/boot/initrd.img-$CUR_KERNEL" ] && cp "/boot/initrd.img-$CUR_KERNEL" "$BOOT_DIR/initrd.img"
    sanitize_host_overlay_cpio
    sync
fi

shred -u "$CONF" 2>/dev/null || rm -f "$CONF"
# Also destroy the copy on the Windows-visible NTFS volume — leaving it there
# would expose the provisioning data (password hash) to anything on Windows.
HOST_CONF="/host$(dirname "$NEXTOS_ROOT_DISK_PATH")/nextos.conf"
if [ -f "$HOST_CONF" ]; then
    shred -u "$HOST_CONF" 2>/dev/null || rm -f "$HOST_CONF"
fi
touch "$COMPLETE"

systemctl disable nextos-firstboot.service 2>/dev/null || true
rm -f /etc/systemd/system/multi-user.target.wants/nextos-firstboot.service

sync
sleep 2
systemctl reboot
